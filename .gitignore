# ── Python ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── IDE churn (PyCharm constantly rewrites these) ─────────
ipdps/.idea/

# ── Runtime / generated workload files ────────────────────
# The active trace is rewritten on every config switch — never track it.
ipdps/simulator_ready_trace.csv
# Per-large-frac traces are regenerated by the runner from the raw inputs.
ipdps/trace_*_lf*.csv
# Synthetic specs written by the profiling/equivalence harness.
ipdps/sim_specs_synth/

# ── Per-run diagnostic outputs ─────────────────────────────
ipdps/epoch_summary.csv
ipdps/simulator_per_request.csv
ipdps/temp.csv
ipdps/LLM_Results/
ipdps/models/

# ── experiment_results: ignore runtime state, keep shareables ──
# The shared-name CSV every machine writes locally (autopush copies it
# to the per-machine name before committing) — exact filename only,
# so LAHyper_Results_<machine>.csv stays trackable.
ipdps/experiment_results/LAHyper_Results.csv
ipdps/experiment_results/.autopush_state
ipdps/experiment_results/*.log
ipdps/AzureLLMInferenceTrace_code_1week.csv
ipdps/AzureLLMInferenceTrace_conv_1week.csv
ipdps/BurstGPT_1.csv
